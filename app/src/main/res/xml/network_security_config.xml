<?xml version="1.0" encoding="utf-8"?>
<!-- Default platform TLS validation, system trust anchors only, no cleartext. Never relaxed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
